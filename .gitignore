# ─────────────────────────────────────────────
#  Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# mypy / pyright
.mypy_cache/
.pyright/

# ─────────────────────────────────────────────
#  Project-specific
# ─────────────────────────────────────────────
# NOTE: adsb_data.db is intentionally NOT ignored — a small sample database
# is committed to the repo so the app can be run without RTL-SDR hardware.
*.sqlite
*.sqlite3

